# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=ecommerce_user
DB_PASSWORD=ecommerce_pass
DB_NAME=ecommerce_app

# Clé de signature des jetons JWT (mettre une valeur longue et secrète)
JWT_SECRET_KEY=change-me-in-production

# Streaming vidéo Agora (étape 3) — à renseigner depuis la console Agora
# https://console.agora.io  ->  App ID + App Certificate
# Laisser vide tant que le compte n'est pas créé : les routes /token
# renverront alors 501 et l'app affichera "streaming indisponible".
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_TTL=3600
